# =============================================================================
#  Content Automation – build-time defaults (OPTIONAL)
# =============================================================================
#
#  You do NOT need this file to use the app. Every key below can (and normally
#  should) be typed directly into the app's Settings screen on the phone, where
#  it is stored encrypted with flutter_secure_storage and never leaves the
#  device.
#
#  This file exists so developers can pre-seed those Settings fields at build
#  time. Copy it to `.env` (which is git-ignored), fill in real values, and pass
#  it to Flutter with --dart-define-from-file:
#
#      cp .env.example .env
#      flutter build apk --release --dart-define-from-file=.env
#
#  Any value still equal to its `YOUR_...` placeholder is ignored by the app.
#  Values that are filled in are copied into secure storage on first launch
#  (only when that Settings field is still empty) and can be changed in-app.
#
#  NEVER commit a real `.env`.
# =============================================================================

# --- YouTube Data API v3 (Google Cloud Console) -------------------------------
# OAuth 2.0 client ID of type **Web application** (Google Sign-In on Android
# uses it as the `serverClientId`). An OAuth client of type *Android* for the
# package com.contentautomation.app + your signing key's SHA-1 must ALSO exist
# in the same Google Cloud project, but its ID is never typed anywhere.
# The Google account itself is chosen on the phone (Settings -> YouTube ->
# Sign in with Google); it cannot be pre-seeded here.
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID
# API key (optional; not needed for uploads)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# --- Instagram Graph API (Meta for Developers) --------------------------------
INSTAGRAM_APP_ID=YOUR_INSTAGRAM_APP_ID
# Long-lived user/page access token with instagram_content_publish permission
INSTAGRAM_ACCESS_TOKEN=YOUR_INSTAGRAM_ACCESS_TOKEN
# Instagram Business/Creator account ID (the {ig-user-id} used by /media)
INSTAGRAM_BUSINESS_ACCOUNT_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID

# --- WhatsApp Agent API -------------------------------------------------------
# Base URL of your WhatsApp agent, e.g. https://agent.example.com/api
# The app sends with  POST {endpoint}/messages  and polls  GET {endpoint}/messages
# (see README "WhatsApp agent contract"). A Meta Cloud API URL such as
# https://graph.facebook.com/v21.0/<PHONE_NUMBER_ID>/messages also works for
# outbound alerts (no inbox / "Status" replies in that case).
WHATSAPP_AGENT_ENDPOINT=YOUR_WHATSAPP_AGENT_ENDPOINT
# Sent as "Authorization: Bearer <key>" and "X-API-Key: <key>" (optional)
WHATSAPP_AGENT_API_KEY=YOUR_WHATSAPP_AGENT_API_KEY
# Phone number (international format, digits only) that should receive alerts
# and whose "Status" messages are answered
WHATSAPP_RECIPIENT_NUMBER=YOUR_WHATSAPP_RECIPIENT_NUMBER
# Optional: separate URL to poll inbound messages from (GET ?since=&limit=)
WHATSAPP_AGENT_INBOX_URL=YOUR_WHATSAPP_AGENT_INBOX_URL

# --- Tunnel for the Instagram device-first bridge (Phase 5) -------------------
# ngrok auth token used to expose the temporary local video server publicly
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN
# Alternative: Cloudflare tunnel token (leave as placeholder if using ngrok)
CLOUDFLARED_TUNNEL_TOKEN=YOUR_CLOUDFLARED_TUNNEL_TOKEN
